# Verify the exact x64 package used by pdfx before native compilation.
# Kept outside generated files and the shared Pub cache.
set(VASMIM_PDFIUM_BUILD "8125")
set(VASMIM_PDFIUM_ARCHIVE_SHA256 "9a964261760cff52570aabf038ab346d3a5034dd8b30d0d5fe8861235d356b8b")
set(VASMIM_PDFIUM_PIN_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}")

function(vasmim_verify_pdfium source archive)
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "Pinned PDFium archive is missing: ${archive}")
  endif()
  file(SHA256 "${archive}" archive_hash)
  if(NOT archive_hash STREQUAL VASMIM_PDFIUM_ARCHIVE_SHA256)
    message(FATAL_ERROR "PDFium archive SHA-256 does not match the reviewed 8125 package")
  endif()
  file(STRINGS "${VASMIM_PDFIUM_PIN_DIRECTORY}/package.sha256" expected_files)
  foreach(entry IN LISTS expected_files)
    if(NOT entry MATCHES "^([a-f0-9]+)  (.+)$")
      message(FATAL_ERROR "Invalid PDFium package manifest entry")
    endif()
    set(expected_hash "${CMAKE_MATCH_1}")
    set(relative_path "${CMAKE_MATCH_2}")
    if(NOT EXISTS "${source}/${relative_path}")
      message(FATAL_ERROR "Pinned PDFium package file is missing: ${relative_path}")
    endif()
    file(SHA256 "${source}/${relative_path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "PDFium package SHA-256 mismatch: ${relative_path}")
    endif()
  endforeach()
  message(STATUS "Verified PDFium 158.0.8125.0 archive and package contents")
endfunction()
